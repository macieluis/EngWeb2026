extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Lista de Atores
    .w3-container
      table.w3-table-all.w3-margin-top
        tr
          th ID
          th Ator
          th #Filmes
        each a in atores
          tr
            td= a.id
            td
              a(href=`/atores/${a.id}`)= a.name
            td= a.films.length
