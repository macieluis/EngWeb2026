extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Lista de Filmes
    .w3-container
      table.w3-table-all.w3-margin-top
        tr
          th ID
          th Titulo
          th Ano
          th #Generos
          th #Cast
        each f in filmes
          tr
            td= f.id
            td
              a(href=`/filmes/${f.id}`)= f.title
            td= f.year
            td= f.genres.length
            td= f.cast.length
