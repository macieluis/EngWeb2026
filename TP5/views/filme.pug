extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1= filme.title
    .w3-container
      table.w3-table-all.w3-margin-top
        tr
          td
            b ID
          td= filme.id
        tr
          td
            b Titulo
          td= filme.title
        tr
          td
            b Ano
          td= filme.year
        tr
          td
            b Generos
          td
            ul
              each g in filme.genres
                li= g
        tr
          td
            b Cast
          td
            ul
              each a in filme.cast
                li= a
