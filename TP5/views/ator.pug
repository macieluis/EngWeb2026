extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1= ator.name
    .w3-container
      table.w3-table-all.w3-margin-top
        tr
          td
            b ID
          td= ator.id
        tr
          td
            b Nome
          td= ator.name
        tr
          td
            b Filmes (#{ator.films.length})
          td
            ul
              each f in ator.films
                li
                  a(href=`/filmes/${f.id}`)= f.title
                  |  (#{f.year})
