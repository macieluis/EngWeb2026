extends layout.pug

block content
  .w3-container
    .w3-card-4.w3-margin-top
      header.w3-container.w3-teal
        h2 Reparação - #{repair.nome}
      .w3-container.w3-padding
        table.w3-table-all
          tr
            td
              b ID
            td= repair._id
          tr
            td
              b Nome
            td= repair.nome
          tr
            td
              b NIF
            td= repair.nif
          tr
            td
              b Data
            td= repair.data
          tr
            td
              b Marca
            td= repair.viatura.marca
          tr
            td
              b Modelo
            td= repair.viatura.modelo
          tr
            td
              b Matrícula
            td= repair.viatura.matricula
          tr
            td
              b Nr. Intervenções
            td= repair.nr_intervencoes
          tr
            td
              b Intervenções
            td
              ul
                each i in repair.intervencoes
                  li
                    b= i.codigo
                    |  - #{i.nome}
                    br
                    em= i.descricao
        .w3-margin-top
          a.w3-button.w3-teal(href='/') Voltar à página principal
