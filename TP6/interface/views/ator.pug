extends layout.pug

block content
  .w3-container
    .w3-card-4.w3-margin-top
      header.w3-container.w3-teal
        h2= ator.name
      .w3-container.w3-padding
        table.w3-table-all
          tr
            td
              b ID
            td= ator._id
          tr
            td
              b Nome
            td= ator.name
          tr
            td
              b Filmes (#{ator.films.length})
            td
              ul
                each f in ator.films
                  li
                    a(href=`/filmes/${f._id}`)= f.title
                    |  (#{f.year})
