extends layout.pug

block content
  .w3-container
    h2 Lista de Atores (#{atores.length})
    table.w3-table-all.w3-margin-top
      tr.w3-teal
        th ID
        th Nome
        th #Filmes
      each a in atores
        tr
          td= a._id
          td
            a(href=`/atores/${a._id}`)= a.name
          td= a.films.length
